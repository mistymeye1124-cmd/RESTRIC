# ==========================================
# GITIGNORE: Telegram Restricted Content Bot
# ==========================================

# 1. Environment & Secret Credentials (CRITICAL)
.env
.env.*
!.env.example
!.env.template

# 2. Telegram Sessions & Auth Keys (CRITICAL - DO NOT COMMIT SESSIONS)
*.session
*.session-journal
*.session-wal
*.session-shm
*.auth
sessions/*
!sessions/.gitkeep
data/sessions_vault.json
!data/.gitkeep

# 3. Databases (User accounts, logs, payment records)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql
bot_database.db
restricted_v2.db
backups/*
!backups/.gitkeep
*.tar.gz
*.zip

# 4. Downloaded Media & Temporary Working Buffers
downloads/*
!downloads/.gitkeep
scratch/*
!scratch/.gitkeep
*.temp
*.tmp
*.part
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.ts
*.mp3
*.m4a
*.aac
*.ogg
*.wav
*.flac
*.opus
*_branded.mp4
*_wm.mp4
*_owner_wm.mp4
*_stage1.mp4

# 5. Sensitive User Branding, Custom Thumbnails, Cookies & Logs
data/branding/*
!data/branding/.gitkeep
data/thumbnails/*
!data/thumbnails/.gitkeep
thumbnails/*
!thumbnails/.gitkeep
cookies/*.txt
!cookies/.gitkeep
*.log
logs/*
!logs/.gitkeep

# 6. Python Artifacts & Virtual Environments
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
env/
ENV/
.venv/
.pytest_cache/
.mypy_cache/

# 7. IDE, Editor & OS Junk Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
*.pid
*.lock
